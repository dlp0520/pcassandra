# ==========================================
# CREDENCIALES DE DATASTAX ASTRA DB (CASSANDRA)
# ==========================================

# 1. Nombre o ruta del archivo "Secure Connect Bundle" (.zip) descargado desde DataStax Astra
# Coloca el archivo .zip en esta misma carpeta o pon la ruta completa
ASTRA_DB_BUNDLE_PATH=secure-connect-tu-bd.zip

# 2. Token de Aplicación generado en Astra DB:
# En Astra DB: Role -> Database Administrator -> Generate Token
# Client ID: suele ser "token" o el Client ID generado
# Client Secret: el valor del Token que inicia con "AstraCS:..."
ASTRA_DB_CLIENT_ID=token
ASTRA_DB_CLIENT_SECRET=AstraCS:tu_token_secreto_aqui

# 3. Keyspace (espacio de claves) configurado al crear la base de datos
ASTRA_DB_KEYSPACE=default_keyspace

# Configuración de la aplicación
PORT=5000
DEBUG=True
